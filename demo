#!/bin/sh
# Pioneer joint firmware (unmodified joint.elf) on a simulated STM32G474RET6, 5.2 s of virtual time.
# ./demo         run it (sim 0.10.0 on PATH, image built; a few minutes wall clock on a laptop)
# ./demo build   build sim/build/joint.elf with PlatformIO first
set -eu
cd "$(dirname "$0")"
if [ "${1:-}" = build ]; then exec sh sim/build.sh; fi
SIM="${SIM:-sim}"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
[ -f sim/build/joint.elf ] || { echo "not built yet: ./demo build" >&2; exit 1; }
mkdir -p sim/out
max=$(sed -n 's/^const float max_target_velocity = \([0-9.]*\);.*/\1/p' src/embedded/STM32/src/main.cpp)
"$SIM" run --scenario sim/scenario.yaml --usb-cdc-console dut.usb --timeout 5.2 --ascii 2>&1 \
  | tee sim/out/demo.log \
  | awk -v max="$max" '
  $2 == "(usb)" {
    msg = substr($0, index($0, "(usb) ") + 6)
    if (msg ~ /^(MOT:sensor dir|MOT:PP check|ERR-MOT:No current|Motor ready)/) printf "firmware [%s] %s\n", substr($1, 2), msg
    next
  }
  /\[canpeer\] sent target/ {
    match($0, /'"'"'[0-9]+'"'"'/); nn = substr($0, RSTART + 1, RLENGTH - 2) + 0
    printf "CAN master  0x123 \"%02d\" -> commanded %.2f rad/s (%g x %d/100)\n", nn, max * nn / 100, max, nn
    next
  }
  /\[canpeer\] / { sub(/^\[canpeer\] /, "peer: "); print; next }
  '
