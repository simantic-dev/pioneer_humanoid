#!/bin/sh
# Pioneer joint firmware (unmodified joint.elf) on a simulated STM32G474RET6, 3.5 s of virtual time.
# ./demo         run it (sim 0.10.0 on PATH, image built; ~30 s wall clock)
# ./demo build   build sim/build/joint.elf with PlatformIO first
set -eu
cd "$(dirname "$0")"
if [ "${1:-}" = build ]; then exec sh sim/build.sh; fi
SIM="${SIM:-sim}"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
[ -f sim/build/joint.elf ] || { echo "not built yet: ./demo build" >&2; exit 1; }
mkdir -p sim/out
max=$(sed -n 's/^const float max_target_velocity = \([0-9.]*\);.*/\1/p' src/embedded/STM32/src/main.cpp)
"$SIM" run --scenario sim/scenario.yaml --usb-cdc-console dut.usb --timeout 3.5 --ascii 2>&1 \
  | tee sim/out/demo.log \
  | awk -v max="$max" '
  function fit(lo, hi,   i, n, sx, sy, sxy, sxx, d) {
    n = sx = sy = sxy = sxx = 0
    for (i = 1; i <= N; i++) if (T[i] >= lo && T[i] <= hi) { n++; sx += T[i]; sy += V[i]; sxy += T[i] * V[i]; sxx += T[i] * T[i] }
    d = n * sxx - sx * sx
    return d != 0 ? (n * sxy - sx * sy) / d : 0
  }
  $2 == "(usb)" {
    fw = substr($1, 2) + 0
    msg = substr($0, index($0, "(usb) ") + 6)
    if (msg ~ /^(MOT:sensor dir|MOT:PP check|ERR-MOT:No current|Motor ready)/) printf "firmware [%.3fs] %s\n", fw, msg
    if (msg ~ /^-?[0-9]+\.[0-9]+$/) { N++; T[N] = fw; V[N] = msg + 0 }
    next
  }
  /\[canpeer\] sent target/ {
    match($0, /'"'"'[0-9]+'"'"'/); nn = substr($0, RSTART + 1, RLENGTH - 2) + 0
    c = fw; target = max * nn / 100
    printf "CAN master  0x123 \"%02d\" -> commanded %.2f rad/s (%g x %d/100)\n", nn, target, max, nn
    next
  }
  /\[plant\] PLANT t=/ {
    tp = substr($3, 3) + 0
    if (c > 0 && !pl && tp >= c + 0.1) {
      pl = 1; printf "plant (PMSM stand-in) t=%.2fs  wm %s rad/s  iq %s  id %s\n", tp, substr($4, 4), substr($5, 4), substr($6, 4)
    }
    next
  }
  /\[canpeer\] / { sub(/^\[canpeer\] /, "peer: "); print; next }
  END {
    if (c <= 0) { print "no CAN command seen: see sim/out/demo.log" > "/dev/stderr"; exit 1 }
    printf "firmware shaft speed (slope of its encoder prints): %.1f rad/s before, %.1f rad/s after command\n", fit(c - 1.5, c - 0.1), fit(c + 0.1, 1e9)
    printf "done: commanded %.2f rad/s, shaft %.1f rad/s after command\n", target, fit(c + 0.1, 1e9)
  }'
