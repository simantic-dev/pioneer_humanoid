#!/bin/sh
# Pioneer joint board on a simulated STM32G474RET6. Usage: ./demo [seconds]
# Needs the firmware image from sim/build.sh (PlatformIO). Uses `sim` from PATH; SIM=/path/to/sim overrides.
set -eu
SIM="${SIM:-sim}"
cd "$(dirname "$0")"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
[ -f sim/build/joint.elf ] || { echo "build first: sim/build.sh" >&2; exit 1; }
"$SIM" run --scenario sim/scenario.yaml --usb-cdc-console dut.usb --timeout "${1:-3.5}" --ascii 2>&1 \
  | grep --line-buffered -E 'MOT:(sensor|PP)|Motor ready|canpeer'
