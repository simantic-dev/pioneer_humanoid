# Sim addition. Scripted CAN master on a free sysbus slot; the scenario puts it on the same bus as
# the joint's fdcan2 (PB12/PB13). HSE is 4.8 MHz, the HSE_VALUE in the firmware's platformio.ini, so the
# firmware's clock tree matches its own build: see README, "Clock".
canpeer: CAN.ScriptedCanNode @ sysbus 0x50100000
    file: "sim/peers/can_peer.py"
rcc:
    hseFrequency: 4800000
